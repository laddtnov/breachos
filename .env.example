# Runtime — required by the serverless functions in api/.
# Set these in the Vercel project, or in .env.local for `vercel dev`.

# Supabase project URL, e.g. https://xxxxxxxx.supabase.co
SUPABASE_URL=

# Service role key. Bypasses row level security — server side only, never
# expose it to the browser. Used by the auth, sync and cron routes.
SUPABASE_SERVICE_ROLE_KEY=

# Publishable (anon) key. Respects row level security; used for the public
# leaderboard reads.
SUPABASE_PUBLISHABLE_KEY=

# Resend API key — welcome, password reset and re-engagement email.
RESEND_API_KEY=

# Shared secret Vercel sends as a bearer token on the scheduled cron route,
# so /api/cron/re-engage cannot be triggered by anyone else.
CRON_SECRET=

# Deploy — GitHub Actions secrets, not application configuration.
# Only needed to run the deploy workflow from CI.
VERCEL_TOKEN=
VERCEL_ORG_ID=
VERCEL_PROJECT_ID=
